# --- AI (optional). Without a key the deterministic parser is used; with one, Claude reads messages first
ANTHROPIC_API_KEY=
OTC_EXTRACTOR=auto            # rules | llm | auto
OTC_LLM_MODEL=claude-sonnet-5-5
OTC_LLM_POLISH=0              # 1 = let Claude polish the tone of clarification emails (facts are guarded)

# --- Integrations: mock (default) | live.   Live clients are written to vendor docs but NOT verified by the author.
OTC_BC_MODE=mock
BC_TENANT_ID=
BC_ENVIRONMENT=Sandbox
BC_COMPANY_ID=
BC_CLIENT_ID=
BC_CLIENT_SECRET=
OTC_HUBSPOT_MODE=mock
HUBSPOT_TOKEN=
OTC_MAGENTO_MODE=mock
MAGENTO_BASE_URL=
MAGENTO_TOKEN=

# --- Outbound mail (optional; otherwise emails are only written to the outbox table)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=orders@example.com
